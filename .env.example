# ============================================================
# 环境变量模板 —— 复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 真实的 .env 已被 .gitignore 挡在库外,不会上传。本文件只是占位说明。
# ============================================================

# --- 数据位置(A→B 翻转点:指向真实 vault 即从 fixtures 切到真实数据)---
# 开发/自测时留空 → 默认用 fixtures/ 假数据
# 个人机/工作机接管时 → 填真实 vault 的绝对路径,无需改代码
WORK_VAULT_PATH=
PERSONAL_VAULT_PATH=

# --- 当前机器身份(必填;影响默认 domain 和新记录 id 的 w/p 后缀)---
# 工作机填 work,个人机填 personal。Codex/命令行直接调用 Python 时也会读取此值。
MACHINE_ID=

# --- 专项 Agent 外挂工作区(仅本机路径,不要提交真实资料)---
# 专项 Agent 的授权任务根与简历/岗位分析/面试材料产出目录；未启用时留空。
# 根 id 来自私有数据仓，禁止把真实值写进代码、文档或 fixtures。
INTERNSHIP_AGENT_ROOT_ID=
INTERNSHIP_WORKSPACE_PATH=

# --- Notion 适配层(可选;当前工作数据用 git 同步,已足够,可暂不填)---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- 执行器 / 模型(按需填,当前阶段可全部留空)---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 本地模型(如用 ollama)
OLLAMA_BASE_URL=http://localhost:11434
